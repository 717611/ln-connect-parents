# Firebase (shared with the LN School Portal). Copy to .env.local for local dev
# and add the same variables in Vercel -> Project Settings -> Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Custom Firestore database ID used by the School Portal (must match exactly).
VITE_FIRESTORE_DATABASE_ID=ai-studio-lninternationals-5d0a906a-852c-4dc9-8b16-611cc88a1568

# Optional
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
